# Gemini API key for the ADK agent (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# ADK reads this to know it's talking to Gemini API directly (not Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

GEMINI_MODEL=gemini-3.8-flash

# SQLite by default. For Cloud SQL Postgres, see README "Google Cloud SQL setup".
DATABASE_URL=sqlite:///./hourglass.db

# Optional free mobile push via https://ntfy.sh — pick any unique topic name,
# leave blank to disable.
NTFY_TOPIC=

CORS_ORIGINS=http://localhost:3000
